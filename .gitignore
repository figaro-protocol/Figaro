# Foundry
out/
cache/
broadcast/
dist/
/verify/

# Node dependencies
node_modules/
frontend/node_modules/
sdk/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
frontend/.next/
frontend/.next-e2e/
frontend/.next-export/
frontend/out/
frontend/build/
frontend/playwright-report/
frontend/test-results/
frontend/tsconfig.tsbuildinfo
# Local dev-server runtime registry (agreement publications etc.) —
# written by `lib/core/agreementPublicationRegistry.server.ts` during
# dev/e2e runs; per-machine state, not source.
frontend/.figaro/
.vercel

# Local Claude Code state. Contributor-facing artifacts (agents/, skills/,
# hooks/, and project-level settings.json) are tracked as ecosystem artifacts;
# personal overrides go in .claude/settings.local.json which stays out of git.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
# ...except personal/machine-specific hooks: the grievance hook hardcodes a
# per-user path and reads a personal memory file, so it stays out of the repo
# (registered in the gitignored settings.local.json instead).
.claude/hooks/grievance-startup.sh

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
.venv/

# Husky internals — auto-generated on `npm install`; only `.husky/pre-commit`
# (and similar hook scripts) should be tracked.
.husky/_/

# IDEs and OS
.DS_Store
.idea/
.vscode/

# Certora
.certora_internal/

# Local deployment state
.deployments/

# Local-only history. Pre-V5 contracts, formal specs, archived frontend, and
# archived design notes are preserved on disk for the maintainer's reference
# but never pushed to GitHub — git history itself preserves prior versions
# at the commit level.
archive-v3/
archive-v4/
archive-frontend/
formal/archive-v3/
archive-v5

# Echidna / Formal Verification
echidna_output.txt
echidna_coverage.txt
echidna-credit-corpus/
corpus/
# Echidna writes per-config corpora like `corpus-v5/`, `corpus-<tag>/`.
corpus-*/
echidna/corpus*/
crytic-export/
states/
formal/states/
formal/.tlacache/
formal/MC_trace_*
# TLA+ Toolbox scratch: auto-generated counterexample/trace-exploration modules.
# Pattern covers FigaroCore, FigToken, and any future model's TTrace outputs.
formal/*_TTrace_*.tla
formal/*_TTrace_*.bin
# tla2tools.jar is a tool binary, not source — downloaded on demand by
# test-tla.sh. Committing it would bloat the repo and obscure its provenance.
formal/tla2tools.jar
tlc_output.txt
*.tla.backup

# Rust / Prover
prover/target/

# Local tool state
.solcx-lock-*
.pytest_cache/

# Test outputs
test-results/
playwright-report/

# Build / analysis artifacts
build-full.txt
coverage-full.txt
coverage-run-*.txt
coverage.json
func_report.txt
lcov.info
coverage/

# Misc
*.log
*.tsbuildinfo

# LaTeX build artifacts (regenerable from .tex via pdflatex/latexmk).
# `.log` is already covered above by `*.log`.
*.aux
*.fdb_latexmk
*.fls
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
