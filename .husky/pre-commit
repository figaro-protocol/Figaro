# Kernel-freeze floor: FAIL the commit if a frozen kernel file (FigaroCore.sol /
# CommitmentTypes.sol) is staged. The .claude/ warn-hook + settings deny are both
# human-bypassable; this is the git-level stop. Override (reviewed change only):
# FIGARO_KERNEL_EDIT=1 git commit ... Runs first so a kernel edit fails fast.
bash scripts/lint-kernel-frozen.sh
npx lint-staged
# Repo-hygiene floor: only the shared agent harness (agents/ skills/ hooks/
# settings.json) may be committed under .claude/; memory files never are. Reads the
# staged set directly — catches paths that match no lint-staged glob.
bash scripts/lint-claude-local-allowlist.sh
bash scripts/lint-claude-md.sh
bash scripts/lint-clause-counts.sh
# Nesting guard: block.nestsUnder must name a STRUCTURED field (enum/array/object) of another
# clause — never a scalar, never a non-existent field. Kills the article-vs-nestsUnder
# conflation (grouping is article's job; nestsUnder is sub-clause refinement). Whole-tree:
# it resolves each target across the full clauses/ set, so it can't be a per-diff check.
bash scripts/lint-clause-nests-under-a-field.sh
# NOTE: the RPGF substrate-broadening-weight guard (retired with the RPGF
# prover) is NOT reinstated with the 2026-07-15 optimistic rebuild — by design:
# the guard kept parallel formula files (Rust + TS mirrors) in sync, and the
# rebuild replaced enforcement with derivation. The formula lives in exactly
# ONE artifact (sdk/src/rpgf/formula.json, anchored on-chain as
# RpgfMinter.formulaHash) and sdk/src/rpgf derives every constant from it —
# there are no parallel copies left to drift. The incentive's RATIONALE lives
# in docs/PUBLIC_GRAPH_MODEL.md.
bash scripts/lint-chain-gas.sh
# Deployment-target floor: no Coinbase Base chain wiring anywhere in the live
# tree (operator ruling 2026-07-23: targets are Ethereum Sepolia → mainnet, NOT
# Base). Whole-tree: certifies state, not just the staged diff.
bash scripts/lint-no-base-chain.sh
# SDK dist freshness: the frontend EXECUTES sdk/dist, and tsc never deletes
# outputs of deleted sources — a stale dist ships deleted APIs into builds and
# poisons audits. Whole-tree: certifies every dist artifact traces to a live
# source. Clean-rebuild: npm --prefix sdk run build (devup does it every run).
bash scripts/lint-sdk-dist-freshness.sh
# Open-world floor: no fabricated network state (?? CONTRACTS / coined emoji),
# swept over the WHOLE tracked tree, not just the staged diff — the structural
# fix for guards that only policed diffs and so never certified repo state.
bash scripts/lint-no-network-fallbacks.sh
# Dead-code guard: knip fails the commit on any orphaned frontend file, unused
# export, or unused type. The tool is the source of truth for what's dead — not
# prose, not memory. ~3s; ignores in frontend/knip.json; namespace-access
# false-positives are tagged `@public` at the declaration.
( cd frontend && npx knip --include files,exports,types --no-progress )
# Semantic open-world gate: a reasoning agent reads the staged diff and blocks
# PRIOR-KNOWLEDGE-OF-THE-REGISTRIES that grep structurally cannot see (field-name+
# meaning couplings). ONE runner, TWO inspectors (SoC): the frontend rulebook watches
# the screens; the protocol rulebook watches the validators + prover. Both share one
# definition of open-world (docs/OPEN_WORLD.md §1). Heaviest check, runs last;
# fail-open so it never bricks a commit on infra. Override: git commit --no-verify.
bash scripts/semantic-precommit-audit.sh frontend '^frontend/.*\.tsx?$' .claude/agents/figaro-open-world-auditor.md
bash scripts/semantic-precommit-audit.sh protocol '^(src/.*\.sol|prover/.*\.rs)$' .claude/agents/figaro-protocol-open-world-auditor.md
