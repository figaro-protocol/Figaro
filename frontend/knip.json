{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["axe-core"],
  "entry": [
    "scripts/**/*.{mjs,cjs}",
    "scripts/webpack/*.cjs!"
  ],
  "project": [
    "**/*.{js,mjs,cjs,ts,tsx}!",
    "!tests/**!",
    "!scripts/**/*.mjs!"
  ],
  "ignore": [
    "tests/e2e/fixtures/inject-ethereum-multi.js",
    "public/sdk-api/**"
  ]
}
