{
    "identity": {
        "id": "local-commerce-reference",
        "name": "Figaro Local Commerce",
        "slug": "local-commerce",
        "description": "Reference assembly for bonded local-commerce coordination: three roles, one root commitment, two sub-orders, atomic settlement. Generic across local-commerce verticals (food, retail, services). Surfaced at /local-commerce (explainer) and /i/local-commerce (runtime instance).",
        "networkTargets": [
            "local-anvil",
            "evm-compatible"
        ],
        "version": "0.1.0"
    },
    "contracts": [
        {
            "key": "core",
            "required": true,
            "description": "Bonded process coordination substrate."
        },
        {
            "key": "dutchAuctionCourierMarket",
            "required": false,
            "description": "High-risk delivery allocation mechanism."
        },
        {
            "key": "deliveryCoordinator",
            "required": false,
            "description": "Low-risk delivery lifecycle coordinator."
        },
        {
            "key": "ghgReporting",
            "required": false,
            "description": "Disclosure/reference-integrity extension."
        },
        {
            "key": "operatorRegistry",
            "required": false,
            "description": "Permissionless merchant/courier self-registration."
        },
        {
            "key": "manifestSchemaRegistry",
            "required": false,
            "description": "On-chain manifest encoding format registry."
        }
    ],
    "serviceBindings": [
        {
            "serviceKey": "catalogue",
            "providerKey": "default-catalogue"
        },
        {
            "serviceKey": "discovery",
            "providerKey": "default-discovery"
        },
        {
            "serviceKey": "evidenceTransport",
            "providerKey": "default-ipfs"
        },
        {
            "serviceKey": "coordinationMessaging",
            "providerKey": "default-coordination-messaging"
        },
        {
            "serviceKey": "handoffPersistence",
            "providerKey": "default-handoff-persistence"
        }
    ],
    "mechanisms": [
        {
            "mechanismId": "core-orders",
            "kind": "core",
            "displayName": "Bonded Order Coordination",
            "riskClass": "read-only-inherited",
            "enabled": true,
            "visibility": "primary",
            "contractKeys": [
                "core",
                "manifestSchemaRegistry"
            ],
            "moduleBindings": [
                "seller-discovery",
                "cart",
                "job-market"
            ]
        },
        {
            "mechanismId": "delivery-coordinator",
            "kind": "coordinator",
            "displayName": "Delivery Lifecycle Coordinator",
            "riskClass": "low-risk-coordinator",
            "enabled": true,
            "visibility": "primary",
            "recognizedRoles": [
                "buyer",
                "merchant",
                "courier"
            ],
            "contractKeys": [
                "core",
                "deliveryCoordinator"
            ],
            "moduleBindings": [
