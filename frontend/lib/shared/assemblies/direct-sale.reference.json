{
    "identity": {
        "id": "direct-sale-reference",
        "name": "Direct Sale",
        "slug": "direct-sale",
        "description": "Reference assembly for one-node bonded sales: buyer commits to merchant; the buyer either consumes on-site or picks up. No delivery, no courier, no sub-orders. Generic across in-person commerce verticals (counter sale, dine-in, pickup, walk-in service, on-site appointment).",
        "networkTargets": [
            "local-anvil",
            "evm-compatible"
        ],
        "version": "0.1.0"
    },
    "contracts": [
        {
            "key": "core",
            "required": true,
            "description": "Bonded process coordination substrate."
        },
        {
            "key": "operatorRegistry",
            "required": false,
            "description": "Permissionless merchant self-registration."
        },
        {
            "key": "manifestSchemaRegistry",
            "required": false,
            "description": "On-chain manifest encoding format registry."
        }
    ],
    "serviceBindings": [
        {
            "serviceKey": "catalogue",
            "providerKey": "default-catalogue"
        },
        {
            "serviceKey": "discovery",
            "providerKey": "default-discovery"
        },
        {
            "serviceKey": "evidenceTransport",
            "providerKey": "default-ipfs"
        }
    ],
    "mechanisms": [
        {
            "mechanismId": "core-orders",
            "kind": "core",
            "displayName": "Bonded Order Coordination",
            "riskClass": "read-only-inherited",
            "enabled": true,
            "visibility": "primary",
            "contractKeys": [
                "core",
                "manifestSchemaRegistry"
            ],
            "moduleBindings": [
                "seller-discovery",
                "cart"
            ]
        },
        {
            "mechanismId": "operator-registration",
            "kind": "registry",
            "displayName": "Operator Registration",
            "riskClass": "low-risk-coordinator",
            "enabled": true,
            "visibility": "secondary",
            "recognizedRoles": [
                "merchant"
            ],
