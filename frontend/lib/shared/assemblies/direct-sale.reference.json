    "narrative": {
        "assemblySummary": "Direct in-person commerce as a one-node bonded process. The buyer commits to a merchant; settlement happens after handoff. No courier, no delivery, no auction. Generic across consume-on-site (dine-in, on-site service) and pickup (counter sale, takeaway, click-and-collect) shapes.",
        "builderNotes": "Reference assembly only. The simplest viable shape — useful as a starting point for any in-person commerce that doesn't need a delivery sub-order."
    },
    "builderMetadata": {
        "assemblyClass": "reference-dapp",
