{
    "identity": {
        "id": "figaro-disclosure-reference",
        "name": "Figaro Disclosure Review",
        "slug": "figaro-disclosure-review",
        "description": "Reference assembly for disclosure-heavy coordination with a narrower, inspector-first module surface.",
        "networkTargets": [
            "local-anvil",
            "evm-compatible"
        ],
        "version": "0.1.0"
    },
    "contracts": [
        {
            "key": "core",
            "required": true,
            "description": "Bonded process coordination substrate."
        },
        {
            "key": "ghgReporting",
            "required": false,
            "description": "Generic disclosure graph for replacing and reviewing submissions."
        }
    ],
    "mechanisms": [
        {
            "mechanismId": "core-orders",
            "kind": "core",
            "displayName": "Bonded Coordination Core",
            "riskClass": "read-only-inherited",
            "enabled": true,
            "visibility": "secondary",
            "contractKeys": [
                "core"
            ],
            "moduleBindings": []
        },
        {
            "mechanismId": "ghg-disclosure",
            "kind": "disclosure",
            "displayName": "GHG Disclosure Graph",
            "riskClass": "medium-risk-extension",
            "enabled": true,
            "visibility": "primary",
            "contractKeys": [
                "core",
                "ghgReporting"
            ],
            "capabilityBindings": [
                "submit-disclosure",
                "replace-disclosure",
                "review-disclosure"
            ],
            "moduleBindings": [
                "mechanism-inspector"
            ]
        }
    ],
    "roles": [
        {
            "roleKind": "buyer",
            "displayName": "Buyer",
            "description": "Creates the order and reviews submitted disclosures before resolving the process.",
            "visibility": "primary",
            "defaultLandingView": "disclosure-workbench",
            "sampleCapabilities": [
                "create-order",
                "resolve-process"
            ]
        },
        {
            "roleKind": "seller",
            "displayName": "Seller",
            "description": "Accepts the order and submits or replaces the required disclosure references.",
            "visibility": "primary",
            "defaultLandingView": "disclosure-workbench",
            "sampleCapabilities": [
                "accept-offer",
                "submit-disclosure",
                "replace-disclosure"
            ]
        },
        {
            "roleKind": "reviewer",
            "displayName": "Reviewer",
            "description": "Inspects disclosure completeness without taking custody of settlement flows.",
            "visibility": "secondary",
            "defaultLandingView": "disclosure-workbench",
            "sampleCapabilities": [
                "review-disclosure"
            ]
        }
    ],
    "views": [
