    "narrative": {
        "assemblySummary": "Equipment rental as a composed assembly: renter and owner each bond collateral. The rental lifecycle (dispatch, receipt, usage, return, inspection) is signaled through a coordinator. If either party defaults, bonds are lost. No arbiter decides — the mechanism enforces.",
        "builderNotes": "Level 2 assembly proving the runtime can express time-bounded rental coordination, not just one-shot delivery or procurement. Uses the same core substrate with a rental-specific coordinator. The key difference from delivery: the process has a return leg, not just a forward leg."
    },
    "builderMetadata": {
        "assemblyClass": "reference-rental",
        "compositionLevel": 2,
        "requiresCustomModules": false,
        "safetyWarnings": [
            "Rental coordinator checkpoints are timestamped attestations only. They do not alter settlement guarantees or enforce return deadlines.",
            "Damage disputes are resolved through the protocol's defense-in-depth layers (MAD, coordination pressure, timestamped evidence), not through arbiter escalation."
        ]
    },
    "defaultRootFulfilment": "pickup"
