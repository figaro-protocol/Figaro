# Figaro Protocol - Environment Variables
# Copy this file to .env.local and fill in the values after deployment

# Chain Selection (Optional — default: local Anvil)
# Set to "base-sepolia" for Base Sepolia testnet deployment
# NEXT_PUBLIC_CHAIN=base-sepolia

# RPC URL (Optional — defaults to /rpc proxy in dev, chain default in production)
# In production, set to your provider endpoint (Alchemy, Infura, etc)
# NEXT_PUBLIC_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Core Protocol Contract Addresses (REQUIRED)
# Get these from: `./deploy-local.sh` output or `.deployments/local.json`
NEXT_PUBLIC_FIGARO_CORE=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PERMIT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Mechanism Modules (deployed by deploy-local.sh)
NEXT_PUBLIC_DUTCH_AUCTION=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ATTESTATION_COORDINATOR=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SCHEMA_REGISTRY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_OPERATOR_REGISTRY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MANIFEST_SCHEMA_REGISTRY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_GHG_REPORTING_MODULE=0x0000000000000000000000000000000000000000

# WalletConnect (Optional — must be 32 hex chars or AppKit is disabled)
# Get your project ID from: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Kleros Dispute Resolution (Optional — omit to disable dispute UI)
# NEXT_PUBLIC_KLEROS_ARBITRABLE_PROXY=0x0000000000000000000000000000000000000000
# NEXT_PUBLIC_KLEROS_ARBITRATOR_EXTRA_DATA=0x
# EVIDENCE_DISPLAY_FRAME_ANCESTORS='self' https://resolve.kleros.io https://*.kleros.io https://*.kleros.eth.limo

# IPFS (Optional — required for Kleros evidence pinning and catalogue/branding)
# NEXT_PUBLIC_IPFS_API_URL=http://127.0.0.1:5001
# NEXT_PUBLIC_IPFS_GATEWAY_URL=http://127.0.0.1:8080

# Development Settings (Optional)
# NEXT_PUBLIC_ENABLE_DEBUG=true

# FIG Token (deployed by `./deploy-local.sh`)
NEXT_PUBLIC_FIG_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_FIG_EMISSION_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_FIG_TIMELOCK_18_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_FIG_TIMELOCK_36_ADDRESS=0x0000000000000000000000000000000000000000

# Batch Verifier (deployed by `./deploy-local.sh`)
NEXT_PUBLIC_BATCH_VERIFIER=0x0000000000000000000000000000000000000000

# Batch Sequencer (Optional — enables batch path in console)
# NEXT_PUBLIC_SEQUENCER_URL=http://127.0.0.1:3001

# Notes:
# - All addresses must be valid Ethereum addresses (0x followed by 40 hex chars)
# - Do NOT use placeholder addresses (0x000...000) in production
# - Run `./deploy-local.sh` to deploy the full local stack and write `frontend/.env.local`
# - Restart the dev server after changing environment variables
