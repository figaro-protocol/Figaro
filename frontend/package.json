{
    "name": "figaro-runtime",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "NODE_OPTIONS=--no-deprecation next dev",
        "build": "next build",
        "start": "node scripts/serve-export.mjs out 3000",
        "serve:export": "node scripts/serve-export.mjs",
        "lint": "next lint",
        "type-check": "tsc --noEmit",
        "knip": "knip",
        "knip:files": "knip --include files",
        "ipfs:scaffold": "node scripts/pin-operator-fixtures.mjs",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:e2e": "npm run test:e2e:devnet",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report",
        "test:e2e:mobile": "playwright test --project=mobile",
        "populate:clauses": "node scripts/populate-clauses.mjs",
        "populate:test-data": "node scripts/populate-test-data.mjs",
        "test:e2e:devnet": "node scripts/verify-devnet-deployment.mjs && node scripts/populate-test-data.mjs && playwright test --project=devnet --workers=1",
        "test:e2e:smoke": "playwright test --project=smoke"
    },
    "dependencies": {
        "@figaro/sdk": "file:../sdk",
        "@rainbow-me/rainbowkit": "^2.2.11",
        "@react-pdf/renderer": "^4.5.1",
        "@tanstack/react-query": "^5.28.0",
        "@xmtp/browser-sdk": "^7.0.0",
        "@xyflow/react": "^12.0.0",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.0",
        "katex": "^0.17.0",
        "lucide-react": "^0.359.0",
        "next": "^14.2.25",
        "qrcode": "^1.5.4",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^2.2.2",
        "viem": "^2.55.1",
        "wagmi": "^2.19.5",
        "zustand": "^4.5.2"
    },
    "devDependencies": {
        "@noble/curves": "^1.9.1",
        "@playwright/test": "^1.58.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^20.11.30",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^18.2.73",
        "@types/react-dom": "^18.2.23",
        "@vitejs/plugin-react": "^5.1.4",
        "@vitest/coverage-v8": "^4.0.18",
        "autoprefixer": "^10.4.19",
        "eslint": "^8.57.0",
        "eslint-config-next": "^14.2.25",
        "jsdom": "^28.1.0",
        "knip": "^6.15.0",
        "postcss": "^8.4.38",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.4.2",
        "vite": "^7.3.2",
        "vitest": "^4.0.18"
    },
    "optionalDependencies": {
        "@next/swc-darwin-x64": "14.2.33"
    }
}
