{
    "name": "figaro-dapp",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "NODE_OPTIONS=--no-deprecation next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "type-check": "tsc --noEmit",
        "ipfs:scaffold": "node scripts/pin-operator-fixtures.mjs",
        "seed:devnet": "node scripts/seed-devnet.mjs",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report",
        "test:e2e:mobile": "playwright test --project=mobile",
        "test:e2e:devnet": "node scripts/verify-devnet-deployment.mjs && node scripts/seed-devnet.mjs && playwright test --project=devnet --workers=1",
        "test:e2e:metamask": "cross-env METAMASK_EXTENSION_PATH=./playwright/extensions/metamask ANVIL_PRIVATE_KEY=$ANVIL_PRIVATE_KEY npx playwright test playwright/tests/connect-with-metamask.spec.ts --project=chromium"
    },
    "dependencies": {
        "@figaro/core": "file:../sdk",
        "@rainbow-me/rainbowkit": "^2.0.5",
        "@react-pdf/renderer": "^4.5.1",
        "@tanstack/react-query": "^5.28.0",
        "@xmtp/browser-sdk": "^7.0.0",
        "@xyflow/react": "^12.0.0",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.0",
        "lucide-react": "^0.359.0",
        "next": "^14.2.25",
        "qrcode": "^1.5.4",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^2.2.2",
        "viem": "^2.7.13",
        "wagmi": "^2.5.7",
        "zustand": "^4.5.2"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^20.11.30",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^18.2.73",
        "@types/react-dom": "^18.2.23",
        "@typescript-eslint/eslint-plugin": "^7.2.0",
        "@vitejs/plugin-react": "^5.1.4",
        "autoprefixer": "^10.4.19",
        "eslint": "^8.57.0",
        "eslint-config-next": "^14.2.25",
        "jsdom": "^28.1.0",
        "postcss": "^8.4.38",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.4.2",
        "vite": "^7.3.2",
        "vitest": "^4.0.18",
        "wait-on": "^9.0.4"
    },
    "optionalDependencies": {
        "@next/swc-darwin-x64": "14.2.33",
        "cross-env": "^7.0.3"
    }
}
