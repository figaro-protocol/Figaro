;; The sandbox wrapper's macOS profile (component 4, F5/F6) — parameterized,
;; launched by run-sandboxed.mjs via sandbox-exec.
;;
;; Posture: default-deny on the boundaries prose cannot enforce —
;;   WRITES  — only the agent's own workspace and the temp dirs, and never
;;             the signer's own directory;
;;   SIGNALS — only to the agent's own processes;
;;   NETWORK — the egress proxy's one loopback port and the signer socket
;;             are the only ways out; every other loopback service (a local
;;             IPFS API, a devnet, another proxy) is as closed as the
;;             internet, so nothing reaches past the policy's allowlist.
;;   READS   — denied by default: this file grants the system, the
;;             workspace and temp; the launcher appends one `allow
;;             file-read*` per path the runtime itself loads (its own
;;             directory, its linked packages, node's install) and per
;;             --allow-read, then one `deny file-read*` per secret path — its
;;             default list (keystores, credentials, shell histories), the
;;             operator's --keystore and --deny-read paths, minus any
;;             default an --allow-read names — last, so a secret inside a
;;             grant stays unreadable (the last matching rule wins).

(version 1)
(allow default)

;; ── Network: the egress proxy's port only ──────────────────────────────
(deny network-outbound)
(allow network-outbound (remote ip (string-append "localhost:" (param "PROXY_PORT"))))
;; The signer's UNIX socket — the one signing capability.
(allow network-outbound (literal (param "SIGNER_SOCKET")))

;; ── Writes: workspace + temp only ──────────────────────────────────────
(deny file-write*)
(allow file-write* (subpath (param "WORKSPACE")))
(allow file-write* (subpath (param "TMPDIR")))
(allow file-write* (subpath "/private/tmp"))
(allow file-write-data
    (literal "/dev/null")
    (literal "/dev/stdout")
    (literal "/dev/stderr")
    (literal "/dev/tty"))
;; The signer's own directory — its socket, its spend journal, its audit log.
;; The journal is what bounds the period: an agent that could truncate it, or
;; append to it, would set its own ceiling. The socket stays connectable: a
;; connection is network-outbound, allowed above. This rule covers the
;; directory and what is under it, not its parents: a directory inside one
;; the agent may write could be renamed away from under the rule, so the
;; launcher refuses a signer directory that is inside the workspace or a temp
;; dir, and passes the directory's real path (the rule matches real paths).
(deny file-write* (subpath (param "SIGNER_DIR")))

;; ── Signals: the agent's own processes only ────────────────────────────
;; A process outside the sandbox — the signer daemon above all — cannot be
;; killed or stopped from inside it.
(deny signal)
(allow signal (target same-sandbox))

;; ── Reads: denied by default ───────────────────────────────────────────
;; A file's contents and a directory's listing are readable only where a
;; rule below grants them. Metadata (stat, a path's existence) stays
;; readable everywhere: resolving any path walks its ancestors, and a secret
;; path's own deny, appended last, covers its metadata too.
(deny file-read*)
(allow file-read-metadata)
(allow file-read-data (literal "/"))
;; The system: binaries, libraries, frameworks, the dyld cache, /etc, /dev.
(allow file-read*
    (subpath "/System")
    (subpath "/usr")
    (subpath "/bin")
    (subpath "/sbin")
    (subpath "/Library")
    (subpath "/opt/homebrew")
    (subpath "/private/etc")
    (subpath "/private/var/db/timezone")
    (subpath "/private/var/select")
    (subpath "/dev"))
;; The system keychains are never system code.
(deny file-read* (subpath "/Library/Keychains"))
;; The agent's own workspace and the temp dirs it may write.
(allow file-read*
    (subpath (param "WORKSPACE"))
    (subpath (param "TMPDIR"))
    (subpath "/private/tmp"))

;; The launcher's grants, then the secret denies, follow (sandboxProfile.mjs).
