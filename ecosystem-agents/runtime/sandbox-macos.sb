;; The sandbox wrapper's macOS profile (component 4, F5/F6) — parameterized,
;; launched by run-sandboxed.mjs via sandbox-exec.
;;
;; Posture: default-deny on the two boundaries prose cannot enforce —
;;   WRITES  — only the agent's own workspace and the temp dirs, and never
;;             the signer's own directory;
;;   SIGNALS — only to the agent's own processes;
;;   NETWORK — loopback only, so the egress proxy (outside the sandbox,
;;             enforcing the policy's allowlist) and the signer socket are
;;             the only ways out.
;; Reads stay default-allow MINUS the named secret paths: the signing key
;; already lives outside the sandboxed process entirely (the policy signer
;; holds it), so the residual read surface is deny-listed explicitly here
;; and shrunk further per deployment via the launcher's parameters.

(version 1)
(allow default)

;; ── Network: loopback only ─────────────────────────────────────────────
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*"))
;; The signer's UNIX socket — the one signing capability.
(allow network-outbound (literal (param "SIGNER_SOCKET")))

;; ── Writes: workspace + temp only ──────────────────────────────────────
(deny file-write*)
(allow file-write* (subpath (param "WORKSPACE")))
(allow file-write* (subpath (param "TMPDIR")))
(allow file-write* (subpath "/private/tmp"))
(allow file-write-data
    (literal "/dev/null")
    (literal "/dev/stdout")
    (literal "/dev/stderr")
    (literal "/dev/tty"))
;; The signer's own directory — its socket, its spend journal, its audit log.
;; The journal is what bounds the period: an agent that could truncate it, or
;; append to it, would set its own ceiling. The socket stays connectable: a
;; connection is network-outbound, allowed above. This rule covers the
;; directory and what is under it, not its parents: a directory inside one
;; the agent may write could be renamed away from under the rule, so the
;; launcher refuses a signer directory that is inside the workspace or a temp
;; dir, and passes the directory's real path (the rule matches real paths).
(deny file-write* (subpath (param "SIGNER_DIR")))

;; ── Signals: the agent's own processes only ────────────────────────────
;; A process outside the sandbox — the signer daemon above all — cannot be
;; killed or stopped from inside it.
(deny signal)
(allow signal (target same-sandbox))

;; ── Reads: named secrets are unreadable ────────────────────────────────
(deny file-read* (subpath (param "DENY_READ_A")))
(deny file-read* (subpath (param "DENY_READ_B")))
(deny file-read* (subpath (param "DENY_READ_C")))
