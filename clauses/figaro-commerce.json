{
    "clauseId": "figaro-commerce",
    "version": 1,
    "title": "Commerce terms",
    "description": "The itemized line items of an order: what its payment buys. The payment and the token are the commitment's own fields, and this clause restates neither. A designer composes it where the parties commit the list, or leaves it out.",
    "fields": [
        {
            "name": "lineItems",
            "type": "array",
            "required": true,
            "minItems": 0,
            "description": "Itemized line items. May be empty for non-itemized orders.",
            "items": {
                "name": "lineItem",
                "type": "object",
                "required": true,
                "fields": [
                    {
                        "name": "itemId",
                        "type": "string",
                        "required": true,
                        "minLength": 1
                    },
                    {
                        "name": "name",
                        "type": "string",
                        "required": true,
                        "minLength": 1
                    },
                    {
                        "name": "quantity",
                        "type": "integer",
                        "required": true,
                        "min": 1
                    },
                    {
                        "name": "unitPrice",
                        "type": "bigint",
                        "required": true,
                        "min": "0"
                    }
                ]
            }
        }
    ],
    "stages": {},
    "block": {
        "design": {
            "article": "mandatory",
            "scope": "agreement",
            "nestsUnder": null,
            "fills": [],
            "composes": null
        },
        "checkout": {
            "catalogueFills": [],
            "profileFills": [],
            "catalogueMeasures": {}
        },
        "runtime": {
            "interaction": null,
            "fields": []
        }
    }
}
