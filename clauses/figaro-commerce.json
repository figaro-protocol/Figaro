{
    "clauseId": "figaro-commerce",
    "version": 1,
    "title": "Commerce terms",
    "description": "Payment amount and itemized line items for the commercial half of an order. The process denomination is NOT here: it is signed in the kernel commitment itself, resolved at checkout as the assembly's figaro-denomination pin (the designer's tailoring, when composed on the root order), else the buyer's pick from the seller's accepted tokens, else the seller's default.",
    "rpgfTag": null,
    "fields": [
        {
            "name": "payment",
            "type": "bigint",
            "required": true,
            "min": "1",
            "description": "Payment amount in the currency's smallest unit. Must be > 0."
        },
        {
            "name": "lineItems",
            "type": "array",
            "required": true,
            "minItems": 0,
            "description": "Itemized line items. May be empty for non-itemized orders.",
            "items": {
                "name": "lineItem",
                "type": "object",
                "required": true,
                "fields": [
                    {
                        "name": "itemId",
                        "type": "string",
                        "required": true,
                        "minLength": 1
                    },
                    {
                        "name": "name",
                        "type": "string",
                        "required": true,
                        "minLength": 1
                    },
                    {
                        "name": "quantity",
                        "type": "integer",
                        "required": true,
                        "min": 1
                    },
                    {
                        "name": "unitPrice",
                        "type": "bigint",
                        "required": true,
                        "min": "0"
                    }
                ]
            }
        }
    ],
    "stages": {},
    "block": {
        "design": {
            "article": "mandatory",
            "nestsUnder": null,
            "fills": [],
            "composes": null
        },
        "checkout": {
            "catalogueFills": [],
            "profileFills": []
        },
        "runtime": {
            "interaction": null,
            "fields": [],
            "handoffStages": []
        }
    }
}
