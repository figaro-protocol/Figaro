{
    "name": "figaro-protocol",
    "private": true,
    "workspaces": [
        "sdk"
    ],
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0"
    },
    "scripts": {
        "dev": "npm --prefix frontend run dev",
        "devup": "bash scripts/devup.sh",
        "build": "npm --prefix frontend run build",
        "start": "npm --prefix frontend run start",
        "test:unit": "npm test --workspaces --if-present",
        "test:e2e": "npm --prefix frontend run test:e2e --",
        "test:e2e:devnet": "npm --prefix frontend run test:e2e:devnet --",
        "prepare": "husky || true"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.60.2"
    }
}
