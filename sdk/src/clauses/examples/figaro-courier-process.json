{
    "clauseId": "figaro-courier-process",
    "version": 1,
    "title": "Courier internal process events",
    "description": "Event stream emitted by a courier seller (driver, cyclist, walker, drone, autonomous vehicle, etc.) to coordinate with buyer and merchant. The event log is the SSoT for the courier's role in the order lifecycle. Generic across transport modes; the event vocabulary maps to a transport job's pickup-to-dropoff flow.",
    "categories": [
        "lifecycle",
        "seller-process"
    ],
    "fields": [
        {
            "name": "eventType",
            "type": "enum",
            "values": [
                "en-route-pickup",
                "arrived-pickup",
                "in-transit",
                "arrived-dropoff",
                "completed"
            ],
            "valueLabels": {
                "en-route-pickup": "En route to pickup",
                "arrived-pickup": "Arrived at pickup",
                "in-transit": "In transit",
                "arrived-dropoff": "Arrived at drop-off",
                "completed": "Completed"
            },
            "required": true,
            "description": "Courier lifecycle event."
        },
        {
            "name": "evidenceUri",
            "type": "string",
            "required": false,
            "minLength": 0,
            "maxLength": 512,
            "description": "Optional reference to off-chain evidence (e.g., GPS log, vehicle photo, signed receipt)."
        }
    ],
    "block": {
        "tier": "runtime",
        "article": "attestations",
        "attestation": "seller",
        "handoffStages": ["arrived-pickup", "arrived-dropoff"],
        "mechanismKinds": [
            "coordinator"
        ],
        "moduleIds": [
            "coordinator-actions",
            "delivery-attestation"
        ]
    }
}
