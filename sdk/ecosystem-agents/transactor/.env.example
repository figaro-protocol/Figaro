# Local Anvil RPC (matches deploy-local.sh).
# For testnet/mainnet, point to your provider and rotate keys appropriately.
RPC_URL=http://127.0.0.1:8545

# Agent wallet private key.
# NEVER commit a real key. Use a fresh key per agent. For autonomous mode, use a
# hardware-isolated or HSM-backed signer in production — never a hot key with
# meaningful balances.
PRIVATE_KEY=0x

# Deployed contract addresses. deploy-local.sh prints these at the end of its run.
FIGARO_CORE_ADDRESS=0x
CLAUSE_REGISTRY_ADDRESS=0x
ATTESTATION_COORDINATOR_ADDRESS=0x
SELLER_REGISTRY_ADDRESS=0x
ASSEMBLY_REGISTRY_ADDRESS=0x

# Polling interval (ms). 15 seconds is reasonable for a local agent;
# production agents should subscribe to events via WebSocket instead.
POLL_INTERVAL_MS=15000

# Policy:
#   hitl       — human reviews and approves each proposed action (DEFAULT, recommended)
#   autonomous — applies a rule-based policy without prompting; ships refuse-all
#                until you implement shouldExecute() in src/policy.ts
POLICY=hitl
