{
    "schemaId": "figaro-delivery-lifecycle-v1",
    "version": 1,
    "title": "Delivery lifecycle attestation",
    "description": "Stage-progression marker for a delivery order. The stage is carried in the attestation envelope (uint8) and validated against the per-stage enum. Optional evidence URI may carry a photo, GPS log, or signed witness payload.",
    "categories": ["lifecycle"],
    "fields": [
        {
            "name": "evidenceUri",
            "type": "string",
            "required": false,
            "minLength": 0,
            "maxLength": 512,
            "description": "Optional reference to off-chain evidence (IPFS CID, HTTPS URL, or empty)."
        }
    ],
    "stages": {
        "0": [{ "name": "evidenceUri", "type": "string", "required": false, "minLength": 0, "maxLength": 512, "description": "preparationStarted: optional evidence." }],
        "1": [{ "name": "evidenceUri", "type": "string", "required": false, "minLength": 0, "maxLength": 512, "description": "readyForPickup: optional evidence." }],
        "2": [{ "name": "evidenceUri", "type": "string", "required": false, "minLength": 0, "maxLength": 512, "description": "courierEnRoute: optional evidence." }],
        "3": [{ "name": "evidenceUri", "type": "string", "required": false, "minLength": 0, "maxLength": 512, "description": "pickedUp: optional evidence." }],
        "4": [{ "name": "evidenceUri", "type": "string", "required": false, "minLength": 0, "maxLength": 512, "description": "delivered: optional evidence." }]
    }
}
